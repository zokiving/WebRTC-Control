{
  "manifest_version": 3,
  "name": "WebRTC Control",
  "version": "1.0.1",
  "minimum_chrome_version": "96",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["privacy"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WebRTC Control",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "20": "icons/20.png", "24": "icons/24.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
